{
	"name": "df_gold_dim_paciente",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_vacunacion_consolidada",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_completo as string,",
				"          sexo as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    paciente_id,\\n    ci_paciente,\\n    nombre_completo,\\n    sexo,\\n    municipio_residencia,\\n    comunidad_indigena\\nFROM silver.vacunacion_consolidada\\nWHERE paciente_id IS NOT NULL',",
				"     format: 'query') ~> source1",
				"source1 aggregate(groupBy(paciente_id),",
				"     ci_paciente = first(ci_paciente),",
				"          nombre_completo = first(nombre_completo),",
				"          sexo = first(sexo),",
				"          municipio_residencia = first(municipio_residencia),",
				"          comunidad_indigena = first(comunidad_indigena)) ~> aggregate1",
				"aggregate1 keyGenerate(output(paciente_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          paciente_key as integer,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_completo as string,",
				"          sexo as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          paciente_id,",
				"          paciente_key,",
				"          ci_paciente,",
				"          nombre_completo,",
				"          sexo,",
				"          municipio_residencia,",
				"          comunidad_indigena",
				"     )) ~> sink1"
			]
		}
	}
}