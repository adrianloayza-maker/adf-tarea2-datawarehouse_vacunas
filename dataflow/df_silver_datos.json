			"scriptLines": [
				"source(output(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as string,",
				"          poblacion_depto_estimada as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    TRIM(municipio_id) AS municipio_id,\\n    TRIM(municipio_nombre) AS municipio_nombre,\\n    TRIM(departamento) AS departamento,\\n    TRIM(codigo_departamento) AS codigo_departamento,\\n    TRIM(zona_geografica) AS zona_geografica,\\n    TRIM(es_capital_departamental) AS es_capital_departamental,\\n    TRIM(poblacion_depto_estimada) AS poblacion_depto_estimada\\nFROM bronze.catalogo_departamentos\\nWHERE municipio_id IS NOT NULL\\nAND TRIM(municipio_id) <> \\'\\'',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          tipo_establecimiento as string,",
				"          nivel_atencion as string,",
				"          zona as string,",
				"          sedes as string,",
				"          red_salud as string,",
				"          departamento as string,",
				"          municipio as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          tiene_cadena_frio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    TRIM(establecimiento_id) AS establecimiento_id,\\n    TRIM(nombre_establecimiento) AS nombre_establecimiento,\\n    TRIM(tipo_establecimiento) AS tipo_establecimiento,\\n    TRIM(nivel_atencion) AS nivel_atencion,\\n    TRIM(zona) AS zona,\\n    TRIM(sedes) AS sedes,\\n    TRIM(red_salud) AS red_salud,\\n    TRIM(departamento) AS departamento,\\n    TRIM(municipio) AS municipio,\\n    TRIM(latitud) AS latitud,\\n    TRIM(longitud) AS longitud,\\n    TRIM(tiene_cadena_frio) AS tiene_cadena_frio,\\n    TRIM(activo) AS activo\\nFROM bronze.catalogo_establecimientos\\nWHERE establecimiento_id IS NOT NULL\\nAND TRIM(establecimiento_id) <> \\'\\'',",
				"     format: 'query') ~> source2",
				"source(output(",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          enfermedad_previene as string,",
				"          grupo_pai as string,",
				"          numero_dosis as string,",
				"          dosis_descripcion as string,",
				"          edad_aplicacion_descripcion as string,",
				"          edad_minima_dias as string,",
				"          edad_maxima_dias as string,",
				"          intervalo_minimo_dias as string,",
				"          via_administracion as string,",
				"          sitio_aplicacion as string,",
				"          dosis_ml as string,",
				"          condicion_especial as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    TRIM(vacuna_id) AS vacuna_id,\\n    TRIM(vacuna_nombre) AS vacuna_nombre,\\n    TRIM(enfermedad_previene) AS enfermedad_previene,\\n    TRIM(grupo_pai) AS grupo_pai,\\n    TRIM(numero_dosis) AS numero_dosis,\\n    TRIM(dosis_descripcion) AS dosis_descripcion,\\n    TRIM(edad_aplicacion_descripcion) AS edad_aplicacion_descripcion,\\n    TRIM(edad_minima_dias) AS edad_minima_dias,\\n    TRIM(edad_maxima_dias) AS edad_maxima_dias,\\n    TRIM(intervalo_minimo_dias) AS intervalo_minimo_dias,\\n    TRIM(via_administracion) AS via_administracion,\\n    TRIM(sitio_aplicacion) AS sitio_aplicacion,\\n    TRIM(dosis_ml) AS dosis_ml,\\n    TRIM(condicion_especial) AS condicion_especial\\nFROM bronze.catalogo_vacunas_pai\\nWHERE vacuna_id IS NOT NULL\\nAND TRIM(vacuna_id) <> \\'\\'',",
				"     format: 'query') ~> source3",
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as string,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as string,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as string,",
				"          edad_dias_aplicacion as string,",
				"          via_administracion as string,",
				"          fuente_datos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(registro_id) AS registro_id,\\n    TRIM(paciente_id) AS paciente_id,\\n    TRIM(ci_paciente) AS ci_paciente,\\n    TRIM(nombre_paciente) AS nombre_paciente,\\n    TRIM(apellido_paterno) AS apellido_paterno,\\n    TRIM(apellido_materno) AS apellido_materno,\\n    TRIM(sexo) AS sexo,\\n    TRIM(fecha_nacimiento) AS fecha_nacimiento,\\n    TRIM(municipio_residencia) AS municipio_residencia,\\n    TRIM(comunidad_indigena) AS comunidad_indigena,\\n    TRIM(fecha_vacunacion) AS fecha_vacunacion,\\n    TRIM(vacuna_id) AS vacuna_id,\\n    TRIM(vacuna_nombre) AS vacuna_nombre,\\n    TRIM(numero_dosis) AS numero_dosis,\\n    TRIM(establecimiento_id) AS establecimiento_id,\\n    TRIM(nombre_establecimiento) AS nombre_establecimiento,\\n    TRIM(departamento) AS departamento,\\n    TRIM(lote_vacuna) AS lote_vacuna,\\n    TRIM(temperatura_conservacion) AS temperatura_conservacion,\\n    TRIM(edad_dias_aplicacion) AS edad_dias_aplicacion,\\n    TRIM(via_administracion) AS via_administracion,\\n    \\'LA_PAZ\\' AS fuente_datos\\nFROM bronze.vacunacion_la_paz\\nWHERE registro_id IS NOT NULL \\nAND TRIM(registro_id) <> \\'\\'',",
				"     format: 'query') ~> source4",
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as string,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as string,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as string,",
				"          edad_dias_aplicacion as string,",
				"          via_administracion as string,",
				"          fuente_datos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '\\nSELECT \\n    TRIM(registro_id) AS registro_id,\\n    TRIM(paciente_id) AS paciente_id,\\n    TRIM(ci_paciente) AS ci_paciente,\\n    TRIM(nombre_paciente) AS nombre_paciente,\\n    TRIM(apellido_paterno) AS apellido_paterno,\\n    TRIM(apellido_materno) AS apellido_materno,\\n    TRIM(sexo) AS sexo,\\n    TRIM(fecha_nacimiento) AS fecha_nacimiento,\\n    TRIM(municipio_residencia) AS municipio_residencia,\\n    TRIM(comunidad_indigena) AS comunidad_indigena,\\n    TRIM(fecha_vacunacion) AS fecha_vacunacion,\\n    TRIM(vacuna_id) AS vacuna_id,\\n    TRIM(vacuna_nombre) AS vacuna_nombre,\\n    TRIM(numero_dosis) AS numero_dosis,\\n    TRIM(establecimiento_id) AS establecimiento_id,\\n    TRIM(nombre_establecimiento) AS nombre_establecimiento,\\n    TRIM(departamento) AS departamento,\\n    TRIM(lote_vacuna) AS lote_vacuna,\\n    TRIM(temperatura_conservacion) AS temperatura_conservacion,\\n    TRIM(edad_dias_aplicacion) AS edad_dias_aplicacion,\\n    TRIM(via_administracion) AS via_administracion,\\n    \\'RURAL_MOVIL\\' AS fuente_datos\\nFROM bronze.vacunacion_rural_movil\\nWHERE registro_id IS NOT NULL \\nAND TRIM(registro_id) <> \\'\\'',",
				"     format: 'query') ~> source5",
				"source(output(",
				"          registro_id as string,",
				"          paciente_id as string,",
				"          ci_paciente as string,",
				"          nombre_paciente as string,",
				"          apellido_paterno as string,",
				"          apellido_materno as string,",
				"          sexo as string,",
				"          fecha_nacimiento as string,",
				"          municipio_residencia as string,",
				"          comunidad_indigena as string,",
				"          fecha_vacunacion as string,",
				"          vacuna_id as string,",
				"          vacuna_nombre as string,",
				"          numero_dosis as string,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as string,",
				"          edad_dias_aplicacion as string,",
				"          via_administracion as string,",
				"          fuente_datos as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT \\n    TRIM(registro_id) AS registro_id,\\n    TRIM(paciente_id) AS paciente_id,\\n    TRIM(ci_paciente) AS ci_paciente,\\n    TRIM(nombre_paciente) AS nombre_paciente,\\n    TRIM(apellido_paterno) AS apellido_paterno,\\n    TRIM(apellido_materno) AS apellido_materno,\\n    TRIM(sexo) AS sexo,\\n    TRIM(fecha_nacimiento) AS fecha_nacimiento,\\n    TRIM(municipio_residencia) AS municipio_residencia,\\n    TRIM(comunidad_indigena) AS comunidad_indigena,\\n    TRIM(fecha_vacunacion) AS fecha_vacunacion,\\n    TRIM(vacuna_id) AS vacuna_id,\\n    TRIM(vacuna_nombre) AS vacuna_nombre,\\n    TRIM(numero_dosis) AS numero_dosis,\\n    TRIM(establecimiento_id) AS establecimiento_id,\\n    TRIM(nombre_establecimiento) AS nombre_establecimiento,\\n    TRIM(departamento) AS departamento,\\n    TRIM(lote_vacuna) AS lote_vacuna,\\n    TRIM(temperatura_conservacion) AS temperatura_conservacion,\\n    TRIM(edad_dias_aplicacion) AS edad_dias_aplicacion,\\n    TRIM(via_administracion) AS via_administracion,\\n    \\'SANTA_CRUZ\\' AS fuente_datos\\nFROM bronze.vacunacion_santa_cruz\\nWHERE registro_id IS NOT NULL \\nAND TRIM(registro_id) <> \\'\\'',",
				"     format: 'query') ~> source6",
				"source1 derive(municipio_nombre = initCap(trim(municipio_nombre)),",
				"          departamento = initCap(trim(departamento)),",
				"          es_capital_departamental = iif(\r",
				"    in(['si','sí','true','1','yes'], lower(trim(toString(es_capital_departamental)))),\r",
				"    true(),\r",
				"    false()\r",
				"),",
				"          poblacion_depto_estimada = toInteger(poblacion_depto_estimada)) ~> LimpiezaCatDepart",
				"source2 derive(nombre_establecimiento = initCap(regexReplace(trim(nombre_establecimiento), '\\\\s+', ' ')),",
				"          tipo_establecimiento = upper(trim(tipo_establecimiento)),",
				"          nivel_atencion = case(     in(['1','1er nivel','primer nivel','nivel 1'], lower(trim(nivel_atencion))), 1,     in(['2','2do nivel','segundo nivel','nivel 2'], lower(trim(nivel_atencion))), 2,     in(['3','3er nivel','tercer nivel','nivel 3'], lower(trim(nivel_atencion))), 3,     0 ),",
				"          departamento = initCap(trim(departamento)),",
				"          municipio = initCap(trim(municipio)),",
				"          latitud = iif(\r",
				"    isNull(latitud),\r",
				"    toFloat(0.0),\r",
				"    toFloat(latitud)\r",
				"),",
				"          longitud = iif(     isNull(longitud),     toFloat(0.0),     toFloat(longitud) ),",
				"          tiene_cadena_frio = iif(     in(['si','sí','true','1','yes'], lower(trim(toString(tiene_cadena_frio)))),     true(),     false() ),",
				"          activo = iif(     in(['si','sí','true','1','yes'], lower(trim(toString(activo)))),     true(),     false() )) ~> LimpiezaCatEstablecimientos",
				"source3 derive(vacuna_nombre = upper(trim(vacuna_nombre)),",
				"          enfermedad_previene = initCap(regexReplace(trim(enfermedad_previene), '\\\\s+', ' ')),",
				"          numero_dosis = toInteger(numero_dosis),",
				"          edad_minima_dias = toInteger(edad_minima_dias),",
				"          edad_maxima_dias = toInteger(edad_maxima_dias),",
				"          intervalo_minimo_dias = toInteger(intervalo_minimo_dias),",
				"          dosis_ml = toDecimal(regexReplace(toString(dosis_ml), '[^0-9.]', '')),",
				"          via_administracion = upper(trim(via_administracion))) ~> LimpiezaVacunas",
				"source4 derive(nombre_paciente = initCap(regexReplace(trim(nombre_paciente), '\\\\s+', ' ')),",
				"          apellido_paterno = initCap(regexReplace(trim(apellido_paterno), '\\\\s+', ' ')),",
				"          apellido_materno = initCap(regexReplace(trim(apellido_materno), '\\\\s+', ' ')),",
				"          sexo = case(     in(['M','Masculino','masculino'], sexo), 'M',     in(['F','Femenino','femenino'], sexo), 'F',     sexo ),",
				"          fecha_nacimiento = coalesce(      toDate(fecha_nacimiento, 'yyyy-MM-dd'),      toDate(fecha_nacimiento, 'dd/MM/yyyy'),      toDate(fecha_nacimiento, 'MM-dd-yyyy'),      toDate(fecha_nacimiento, 'yyyy/MM/dd') ),",
				"          municipio_residencia = initCap(regexReplace(trim(municipio_residencia), '\\\\s+', ' ')),",
				"          comunidad_indigena = iif(     in(['si','sí','true','1','yes'], lower(trim(toString(comunidad_indigena)))),     true(),     false() ),",
				"          vacuna_nombre = upper(trim(vacuna_nombre)),",
				"          numero_dosis = toInteger(numero_dosis),",
				"          nombre_establecimiento = initCap(regexReplace(trim(nombre_establecimiento), '\\\\s+', ' ')),",
				"          departamento = case(     in(['SCZ','Santa Cruz','santa cruz'], departamento), 'Santa Cruz',     in(['LPZ','La Paz','la paz'], departamento), 'La Paz',     in(['CBBA','Cochabamba'], departamento), 'Cochabamba',     upper(trim(departamento)) ),",
				"          temperatura_conservacion = toDecimal(regexReplace(toString(temperatura_conservacion), '[^0-9.-]', '')),",
				"          edad_dias_aplicacion = toInteger(edad_dias_aplicacion),",
				"          via_administracion = upper(trim(via_administracion)),",
				"          fecha_vacunacion = coalesce(      toDate(fecha_vacunacion, 'yyyy-MM-dd'),      toDate(fecha_vacunacion, 'dd/MM/yyyy'),      toDate(fecha_vacunacion, 'MM-dd-yyyy'),      toDate(fecha_vacunacion, 'yyyy/MM/dd'),      toDate(fecha_vacunacion, 'dd-MMM-yyyy'),     toDate(fecha_vacunacion, 'MMMM dd, yyyy'),     toDate(fecha_vacunacion, \"dd 'de' MMMM 'de' yyyy\") )) ~> LimpiezaVacLaPaz",
				"source5 derive(nombre_paciente = initCap(regexReplace(trim(nombre_paciente), '\\\\s+', ' ')),",
				"          apellido_paterno = initCap(regexReplace(trim(apellido_paterno), '\\\\s+', ' ')),",
				"          apellido_materno = initCap(regexReplace(trim(apellido_materno), '\\\\s+', ' ')),",
				"          sexo = case(     in(['M','Masculino','masculino'], sexo), 'M',     in(['F','Femenino','femenino'], sexo), 'F',     sexo ),",
				"          fecha_nacimiento = coalesce(      toDate(fecha_nacimiento, 'yyyy-MM-dd'),      toDate(fecha_nacimiento, 'dd/MM/yyyy'),      toDate(fecha_nacimiento, 'MM-dd-yyyy'),      toDate(fecha_nacimiento, 'yyyy/MM/dd') ),",
				"          fecha_vacunacion = coalesce( \r",
				"    toDate(fecha_vacunacion, 'yyyy-MM-dd'), \r",
				"    toDate(fecha_vacunacion, 'dd/MM/yyyy'), \r",
				"    toDate(fecha_vacunacion, 'MM-dd-yyyy'), \r",
				"    toDate(fecha_vacunacion, 'yyyy/MM/dd'), \r",
				"    toDate(fecha_vacunacion, 'dd-MMM-yyyy'),\r",
				"    toDate(fecha_vacunacion, 'MMMM dd, yyyy'),\r",
				"    toDate(fecha_vacunacion, \"dd 'de' MMMM 'de' yyyy\")\r",
				"),",
				"          municipio_residencia = initCap(regexReplace(trim(municipio_residencia), '\\\\s+', ' ')),",
				"          comunidad_indigena = iif(     in(['si','sí','true','1','yes'], lower(trim(toString(comunidad_indigena)))),     true(),     false() ),",
				"          vacuna_nombre = upper(trim(vacuna_nombre)),",
				"          numero_dosis = toInteger(numero_dosis),",
				"          nombre_establecimiento = initCap(regexReplace(trim(nombre_establecimiento), '\\\\s+', ' ')),",
				"          departamento = case(     in(['SCZ','Santa Cruz','santa cruz'], departamento), 'Santa Cruz',     in(['LPZ','La Paz','la paz'], departamento), 'La Paz',     in(['CBBA','Cochabamba'], departamento), 'Cochabamba',     upper(trim(departamento)) ),",
				"          temperatura_conservacion = toDecimal(regexReplace(toString(temperatura_conservacion), '[^0-9.-]', '')),",
				"          edad_dias_aplicacion = toInteger(edad_dias_aplicacion),",
				"          via_administracion = upper(trim(via_administracion))) ~> LimpiezaVacRural",
				"source6 derive(nombre_paciente = initCap(regexReplace(trim(nombre_paciente), '\\\\s+', ' ')),",
				"          apellido_paterno = initCap(regexReplace(trim(apellido_paterno), '\\\\s+', ' ')),",
				"          apellido_materno = initCap(regexReplace(trim(apellido_materno), '\\\\s+', ' ')),",
				"          sexo = case(     in(['M','Masculino','masculino'], sexo), 'M',     in(['F','Femenino','femenino'], sexo), 'F',     sexo ),",
				"          fecha_nacimiento = coalesce(      toDate(fecha_nacimiento, 'yyyy-MM-dd'),      toDate(fecha_nacimiento, 'dd/MM/yyyy'),      toDate(fecha_nacimiento, 'MM-dd-yyyy'),      toDate(fecha_nacimiento, 'yyyy/MM/dd') ),",
				"          fecha_vacunacion = coalesce(      toDate(fecha_vacunacion, 'yyyy-MM-dd'),      toDate(fecha_vacunacion, 'dd/MM/yyyy'),      toDate(fecha_vacunacion, 'MM-dd-yyyy'),      toDate(fecha_vacunacion, 'yyyy/MM/dd') ),",
				"          municipio_residencia = initCap(regexReplace(trim(municipio_residencia), '\\\\s+', ' ')),",
				"          comunidad_indigena = iif(     in(['si','sí','true','1','yes'], lower(trim(toString(comunidad_indigena)))),     true(),     false() ),",
