{
	"name": "df_gold_dim_establecimiento",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_establecimientos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_establecimiento",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          tipo_establecimiento as string,",
				"          nivel_atencion as integer,",
				"          zona as string,",
				"          sedes as string,",
				"          red_salud as string,",
				"          departamento as string,",
				"          municipio as string,",
				"          latitud as decimal(18,8),",
				"          longitud as decimal(18,8),",
				"          tiene_cadena_frio as boolean,",
				"          activo as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    establecimiento_id,\\n    nombre_establecimiento,\\n    tipo_establecimiento,\\n    nivel_atencion,\\n    zona,\\n    sedes,\\n    red_salud,\\n    departamento,\\n    municipio,\\n    latitud,\\n    longitud,\\n    tiene_cadena_frio,\\n    activo\\nFROM silver.establecimientos\\nWHERE establecimiento_id IS NOT NULL',",
				"     format: 'query') ~> source1",
				"source1 aggregate(groupBy(establecimiento_id),",
				"     nombre_establecimiento = first(nombre_establecimiento),",
				"          tipo_establecimiento = first(tipo_establecimiento),",
				"          nivel_atencion = first(nivel_atencion),",
				"          zona = first(zona),",
				"          sedes = first(sedes),",
				"          red_salud = first(red_salud),",
				"          departamento = first(departamento),",
				"          municipio = first(municipio),",
				"          tiene_cadena_frio = first(municipio)) ~> aggregate1",
				"aggregate1 keyGenerate(output(establecimiento_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          establecimiento_key as integer,",
				"          establecimiento_id as string,",
				"          nombre_establecimiento as string,",
				"          tipo_establecimiento as string,",
				"          nivel_atencion as integer,",
				"          zona as string,",
				"          sedes as string,",
				"          red_salud as string,",
				"          departamento as string,",
				"          municipio as string,",
				"          tiene_cadena_frio as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          establecimiento_key,",
				"          establecimiento_id,",
				"          nombre_establecimiento,",
				"          tipo_establecimiento,",
				"          nivel_atencion,",
				"          zona,",
				"          sedes,",
				"          red_salud,",
				"          departamento,",
				"          municipio,",
				"          tiene_cadena_frio",
				"     )) ~> sink1"
			]
		}
	}
}